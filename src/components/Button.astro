---
import type { HTMLAttributes } from 'astro/types';
interface Props extends Omit<HTMLAttributes<'button'>, 'class' | 'style'> {
  variant?: 'primary' | 'secondary';
}
const { variant = 'primary', type = 'button', ...attributes } = Astro.props;
---
<button {...attributes} type={type} class:list={['button', { 'button--secondary': variant === 'secondary' }]}><slot /></button>
