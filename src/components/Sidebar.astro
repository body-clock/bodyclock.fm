---
import Button from './Button.astro';
import { navLinks } from '../data/navigation';
const currentPath = Astro.url.pathname;
---

<aside class="sidebar">
  <p class="author">By <a href="/" class={currentPath === '/' ? 'current' : ''}>Patrick Perkins</a></p>
  
  <nav class="sidebar-nav" aria-label="Main navigation">
    {navLinks.map((link) => (
      <a href={link.href} class={currentPath.startsWith(link.href) ? 'current' : ''} aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>

  <div class="subscribe-action"><Button variant="secondary" data-subscribe>Subscribe</Button></div>
</aside>

<style>
  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    padding-top: 0;
    border-right: var(--border);
    padding-right: var(--space-4);
  }
  
  @media (max-width: 640px) {
    .sidebar {
      display: none;
    }
  }
  
  .author {
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    line-height: 1.4;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }
  
  .author a {
    color: var(--color-text);
    text-decoration: none;
  }
  
  .author a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  
  .author a.current {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  
  .subscribe-action { margin-top: var(--space-8); }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-end;
  }
  
  .sidebar-nav a {
    text-decoration: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    min-height: var(--touch-target-min);
  }
  
  .sidebar-nav a:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  
  .sidebar-nav a.current {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
