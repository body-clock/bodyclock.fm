---
export const prerender = true;
import DaringLayout from '../../layouts/DaringLayout.astro';
import PostFeed from '../../components/PostFeed.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<DaringLayout title="Blog" description="Articles by Patrick Perkins on web development, developer tools, agentic development, and building software and music projects.">
  <h1>Blog</h1>
  <PostFeed posts={posts} showExcerpts />
</DaringLayout>
