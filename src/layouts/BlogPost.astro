---
import Tag from '../components/Tag.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import DaringLayout from './DaringLayout.astro';
import { SITE_DESCRIPTION } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description = SITE_DESCRIPTION, date, updatedDate, tags, heroImage } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
const imageURL = new URL(heroImage?.src ?? '/og-image.png', Astro.site).href;

const blogSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	'@id': `${canonicalURL}#article`,
	url: canonicalURL,
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
	image: [imageURL],
	inLanguage: 'en',
	keywords: tags.join(', '),
	isPartOf: { '@id': new URL('/#website', Astro.site).href },
	headline: title,
	description: description,
	datePublished: date.toISOString(),
	dateModified: (updatedDate ?? date).toISOString(),
	author: {
		'@type': 'Person',
		name: 'Patrick Perkins',
		url: 'https://bodyclock.fm',
	},
};
---

<DaringLayout title={title} description={description} schema={blogSchema} type="article" image={heroImage} publishedTime={date} modifiedTime={updatedDate ?? date} tags={tags}>
  <article class="blog-post">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-date">
        <FormattedDate date={date} />
        {updatedDate && (
          <span class="updated"> (updated <FormattedDate date={updatedDate} />)</span>
        )}
      </p>
      {tags && tags.length > 0 && (
        <div class="tag-list">
          {tags.map((tag) => (
            <Tag tag={tag} />
          ))}
        </div>
      )}
    </header>

    {heroImage && (
      <div class="hero-image">
        <Image width={1020} height={510} src={heroImage} alt="" />
      </div>
    )}

    <div class="prose">
      <slot />
    </div>

    <div class="comments-section">
      <h2>Comments</h2>
      <div id="giscus-container"></div>
      <script>
        const script = document.createElement('script');
        script.src = 'https://giscus.app/client.js';
        script.setAttribute('data-repo', 'body-clock/bodyclock.fm');
        script.setAttribute('data-repo-id', 'R_kgDOS6v9_Q');
        script.setAttribute('data-category', 'Announcements');
        script.setAttribute('data-category-id', 'DIC_kwDOS6v9_c4C_V6Y');
        script.setAttribute('data-mapping', 'pathname');
        script.setAttribute('data-strict', '0');
        script.setAttribute('data-reactions-enabled', '1');
        script.setAttribute('data-emit-metadata', '0');
        script.setAttribute('data-input-position', 'bottom');
        script.setAttribute('data-theme', 'transparent_dark');
        script.setAttribute('data-lang', 'en');
        script.crossOrigin = 'anonymous';
        script.async = true;
        document.getElementById('giscus-container')?.appendChild(script);
      </script>
    </div>
  </article>
</DaringLayout>

<style>
  .post-header {
    margin-bottom: var(--space-6);
  }
  
  .post-header h1 {
    margin-bottom: var(--space-2);
  }
  
  .post-date {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    font-weight: 400;
  }
  
  .updated {
    font-style: italic;
  }
  
  .hero-image {
    margin-bottom: var(--space-6);
  }
  
  .hero-image img {
    width: 100%;
  }
  
  .comments-section {
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
    padding-top: var(--space-6);
    border-top: var(--border);
  }
  
  .comments-section h2 {
    margin-bottom: var(--space-1);
  }
  
  .comments-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  
  .comments-note a {
    color: var(--color-accent);
  }
  
  @media (max-width: 720px) {
    .comments-section {
      margin-top: var(--space-6);
      margin-bottom: var(--space-6);
      padding-top: var(--space-4);
    }
  }
</style>
